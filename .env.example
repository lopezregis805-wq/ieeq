# ============================================================
# .env.example — plantilla de configuración local
#
# Copia este archivo a ".env" (o defínelas como SetEnv en tu
# VirtualHost de Apache) y pon AHÍ tus valores reales.
# El archivo ".env" está en .gitignore: nunca se sube al repo.
# ============================================================

IEEQ_DB_HOST=localhost
IEEQ_DB_NAME=ieeq_registro
IEEQ_DB_USER=ieeq_app
IEEQ_DB_PASS=cambia_esto_por_tu_password_local

# Opcional: URL pública por la que se accede al sistema. Se usa como
# liga de acceso en los correos de notificación (alta/baja de cuenta) y
# como base para que el emblema de la asociación se vea en esos correos.
IEEQ_URL_SISTEMA=https://afiliaciones.ieeq.mx

# Opcional: notificaciones por correo al crear o dar de baja una cuenta
# (usuarios.pl, lib/Correo.pm). Si se dejan vacías, el sistema sigue
# funcionando normal — solo se avisa en pantalla que el correo no se
# pudo enviar, nunca bloquea el alta/baja del usuario.
IEEQ_SMTP_HOST=smtp.office365.com
IEEQ_SMTP_PORT=587
IEEQ_SMTP_USER=
IEEQ_SMTP_PASS=
IEEQ_SMTP_NOMBRE=Sistema de Registro IEEQ
